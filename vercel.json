{
  "version": 2,
  "builds": [
    { "src": "api/rates.js", "use": "@vercel/node" },
    { "src": "api/binance-balance.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/rates", "dest": "/api/rates.js" },
    { "src": "/api/binance-balance", "dest": "/api/binance-balance.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
